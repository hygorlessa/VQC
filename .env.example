# ============================================================================
# VQC v6.0 — Virtual Quality Control & Advance Scout (Google Cloud Production)
# ============================================================================

# 1. Google Cloud Project & Region (Required for Vertex AI, Firestore & GCS)
GCP_PROJECT_ID="your-gcp-project-id"
GCP_REGION="us-central1"

# 2. Private Google Cloud Storage Bucket for Direct Resumable Video Uploads & Extracted Frames
GCS_BUCKET="vqc-film-your-gcp-project-id"

# 3. Vertex AI Gemini Models (Uses gs:// URIs directly via Vertex AI Service Agent)
GEMINI_FAST_MODEL="gemini-2.5-flash"
GEMINI_DEEP_MODEL="gemini-2.5-pro"
GEMINI_VIDEO_MODEL="gemini-2.5-flash"

# 4. Firebase Client Authentication Configuration (Frontend Vite Env Vars)
VITE_FIREBASE_API_KEY="your-firebase-web-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-gcp-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-gcp-project-id"
VITE_FIREBASE_STORAGE_BUCKET="vqc-film-your-gcp-project-id"
VITE_FIREBASE_APP_ID="your-firebase-app-id"

# 5. Optional: Service Account JSON string when running outside Cloud Run without ADC
# (In Cloud Run, Workload Identity / attached vqc-runtime-sa is used automatically)
# GCP_SERVICE_ACCOUNT_KEY='{"type":"service_account",...}'

# 6. Optional: Custom FFmpeg / FFprobe binary paths if not on system PATH
# FFMPEG_PATH="/usr/bin/ffmpeg"
# FFPROBE_PATH="/usr/bin/ffprobe"

# Opt-in ONLY after legal/licensing approval of all locally imported curriculum metadata.
VQC_EXTERNAL_CURRICULUM_AUTHORIZED=false
# Absolute path to an authorized JSONL file accessible to the Cloud Run/local process.
VQC_CURRICULUM_STORE_PATH=
