{
  "name": "vqc-football-intelligence",
  "private": true,
  "version": "7.2.1",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=server.js",
    "start": "node server.js",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "smoke:milestone1": "tsx scripts/smoke-test-milestone1.ts",
    "package:release": "tsx scripts/package-release.ts",
    "curriculum:build": "tsx scripts/build-external-football-curriculum.ts",
    "curriculum:normalize": "tsx scripts/normalize-external-football-curriculum.ts",
    "film:offline": "tsx scripts/prepare-offline-film.ts",
    "test:offline": "node scripts/run-offline-tests.cjs",
    "release:verify": "node scripts/verify-release.cjs",
    "benchmark:film": "tsx scripts/evaluate-curriculum-benchmark.ts"
  },
  "dependencies": {
    "@google-cloud/firestore": "^7.11.0",
    "@google-cloud/storage": "^8.2.0",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^11.4.0",
    "firebase-admin": "^13.2.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "xlsx": "^0.18.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
